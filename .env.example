# Copy to .env.local for local development. Placeholders only - never commit real values.

# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for booking creation, lookup, rate limiting and the create-admin script.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public URL of the site (no trailing slash). On Vercel use the canonical www domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random secret, 32+ chars (e.g. `openssl rand -base64 48`). Derives private access links and salts rate-limit keys.
# Changing it invalidates retry-safety of in-flight submissions only; stored access links keep working (they are hashed in the DB).
APP_SECRET=REPLACE-WITH-A-LONG-RANDOM-STRING-AT-LEAST-32-CHARS
